{
  "name": "flare",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "flare",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {}
    },
    "apps/api": {
      "name": "@flare/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@flare/web",
      "version": "0.1.0"
    },
    "node_modules/@flare/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@flare/db": {
      "resolved": "packages/db",
      "link": true
    },
    "node_modules/@flare/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/db": {
      "name": "@flare/db",
      "version": "0.1.0"
    }
  }
}
