# Public build-time configuration for the web client. In CI these come from GitHub secrets.
# For local runs copy to `.env.local` (git-ignored).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# Optional: serve the 3D models from another origin (for example a public R2 bucket).
# NEXT_PUBLIC_ASSETS_URL=https://assets.example.com
