{
  "name": "@flare/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flare API: a Hono application on Cloudflare Workers that orchestrates speech-to-text, the LLM, and text-to-speech.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
