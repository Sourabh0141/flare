    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@flare/contracts": "*",
    "@flare/db": "*",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.6",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.139.0"
  }
