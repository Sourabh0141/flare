{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs is included in the free plan; 100% sampling is fine at this traffic level.
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flare-db",
      "database_id": "0a661df7-5c0b-4966-837d-a9e65a2c3d77",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],

  // Rate Limiting bindings are GA and free. Counters are per Cloudflare location, so treat
  // these as abuse ceilings rather than exact quotas.
  "ratelimits": [
    {
      "name": "TURN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 40, "period": 60 },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 240, "period": 60 },
    },
  ],

  // Non-secret configuration. Secrets (CLERK_JWT_KEY, CLERK_SECRET_KEY, DEEPINFRA_API_KEY)
  // are set with `wrangler secret put` and never live in this file.
  "vars": {
    "APP_VERSION": "1.0.0",
    "ALLOWED_ORIGINS": "https://flare-web.pages.dev,https://*.flare-web.pages.dev,http://localhost:3000",
    "DEEPINFRA_STT_MODEL": "openai/whisper-large-v3-turbo",
    "DEEPINFRA_LLM_MODEL": "meta-llama/Meta-Llama-3.1-8B-Instruct",
    "DEEPINFRA_TTS_MODEL": "hexgrad/Kokoro-82M",
    "DEEPINFRA_TTS_VOICE": "af_heart",
  },
}
